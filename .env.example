# Copy to .env (gitignored) and fill in. Real environment variables override these.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# local (vLLM, default) | openrouter | anthropic | openai
PILOT_LLM_PROVIDER=local
# Required for openrouter and openai (e.g. a provider/model slug); anthropic defaults to claude-sonnet-5-5
PILOT_LLM_MODEL=
